# Copy to .env (gitignored) and fill in.
# All keys here are read by kgconvai.config.Settings.

# Mode: local | api | template
KGCONVAI_LLM_MODE=template

# OpenRouter (only needed for KGCONVAI_LLM_MODE=api)
KGCONVAI_OPENROUTER_API_KEY=
KGCONVAI_OPENROUTER_MODEL=deepseek/deepseek-v3-base:free

# Ollama (only needed for KGCONVAI_LLM_MODE=local)
KGCONVAI_OLLAMA_URL=http://localhost:11434/api/generate
KGCONVAI_OLLAMA_MODEL=llama3

# ASR
KGCONVAI_WHISPER_MODEL=base
KGCONVAI_VAD_AGGRESSIVENESS=2

# Logging
KGCONVAI_LOG_LEVEL=INFO
